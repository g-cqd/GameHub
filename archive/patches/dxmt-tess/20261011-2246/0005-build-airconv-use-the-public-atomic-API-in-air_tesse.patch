From 2d4d1a911891dac6f2fdd107e3c12d49159e8903 Mon Sep 17 00:00:00 2001
From: Gigi <42325924+g-cqd@users.noreply.github.com>
Date: Sun, 11 Oct 2026 22:46:25 +0200
Subject: [PATCH 5/6] build(airconv): use the public atomic API in
 air_tessellation.metal

Metal toolchain 32023 (macOS 27 SDK) changed the private builtin
__metal_atomic_fetch_add_explicit to five arguments, so the shader no
longer compiled. atomic_fetch_add_explicit on a threadgroup atomic_int with
memory_order_relaxed is the same operation; it compiles to
air.atomic.local.add.s.i32 with order 0 (relaxed) and scope 1
(threadgroup).
---
 src/airconv/shaders/air_tessellation.metal | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/src/airconv/shaders/air_tessellation.metal b/src/airconv/shaders/air_tessellation.metal
index 56ba86e..7b76587 100644
--- a/src/airconv/shaders/air_tessellation.metal
+++ b/src/airconv/shaders/air_tessellation.metal
@@ -150,7 +150,10 @@ struct TessMeshWorkload {
 
 int
 get_next_index(threadgroup int *out_count) {
-  return __metal_atomic_fetch_add_explicit(out_count, 1, int(memory_order_relaxed), __METAL_MEMORY_SCOPE_THREADGROUP__);
+  // Public API instead of the private __metal_atomic_fetch_add_explicit builtin, whose
+  // signature changed in newer Metal toolchains (32023: 5 arguments). Same operation:
+  // relaxed add, threadgroup scope.
+  return atomic_fetch_add_explicit((threadgroup atomic_int *)out_count, 1, memory_order_relaxed);
 }
 
 template <partitioning partition>
