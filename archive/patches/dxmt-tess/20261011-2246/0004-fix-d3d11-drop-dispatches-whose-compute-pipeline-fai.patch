From 82b4f16e0bee910779a6434fe68eede89aa5198d Mon Sep 17 00:00:00 2001
From: Gigi <42325924+g-cqd@users.noreply.github.com>
Date: Sun, 11 Oct 2026 22:34:06 +0200
Subject: [PATCH 4/6] fix(d3d11): drop dispatches whose compute pipeline failed
 to compile

Same defect as for draws: when a compute pipeline failed to compile, only
the set-pipeline command was skipped and Dispatch/DispatchIndirect still
ran, with the previously bound compute pipeline and bindings laid out for
another shader. ComputeEncoderData::pipeline_failed now records the
failure and both dispatch paths drop the dispatch while it is set (one
warning). Compute pipeline creation also retries when the compiler
service connection was interrupted (CreatePipelineRetryingInterrupted,
shared with the render pipelines).

No regression test: a compute pipeline that fails to compile cannot be
produced on purpose (D3D11 and Metal limits on threads and threadgroup
memory match).
---
 src/d3d11/d3d11_context_impl.cpp | 11 ++++++++++-
 src/d3d11/d3d11_pipeline.cpp     |  3 ++-
 src/d3d11/d3d11_pipeline.hpp     | 16 +++++++++++-----
 src/dxmt/dxmt_context.hpp        | 12 ++++++++++++
 4 files changed, 35 insertions(+), 7 deletions(-)

diff --git a/src/d3d11/d3d11_context_impl.cpp b/src/d3d11/d3d11_context_impl.cpp
index fdd91eb..52d09be 100644
--- a/src/d3d11/d3d11_context_impl.cpp
+++ b/src/d3d11/d3d11_context_impl.cpp
@@ -1784,6 +1784,8 @@ public:
     if (!PreDispatch())
       return;
     EmitOP([ThreadGroupCountX, ThreadGroupCountY, ThreadGroupCountZ](ArgumentEncodingContext &enc) {
+      if (enc.currentComputeEncoder()->pipeline_failed)
+        return;
       enc.resolveComputePassBarrier();
       auto &cmd = enc.encodeComputeCommand<wmtcmd_compute_dispatch>();
       cmd.type = WMTComputeCommandDispatch;
@@ -1800,6 +1802,8 @@ public:
       return;
     if (auto bindable = GetResourceCommon(pBufferForArgs)) {
       EmitOP([AlignedByteOffsetForArgs, ArgBuffer = bindable->buffer()](ArgumentEncodingContext &enc) {
+        if (enc.currentComputeEncoder()->pipeline_failed)
+          return;
         auto [buffer, buffer_offset] = enc.access(ArgBuffer, AlignedByteOffsetForArgs, 12, ResourceAccess::Read);
         enc.resolveComputePassBarrier();
         auto &cmd = enc.encodeComputeCommand<wmtcmd_compute_dispatch_indirect>();
@@ -4964,8 +4968,13 @@ public:
                ArgumentEncodingContext &enc) {
       MTL_COMPILED_COMPUTE_PIPELINE ComputePipeline;
       pso->GetPipeline(&ComputePipeline); // may block
-      if (!ComputePipeline.PipelineState)
+      enc.currentComputeEncoder()->pipeline_failed = ComputePipeline.PipelineState == nullptr;
+      if (!ComputePipeline.PipelineState) {
+        static std::atomic_bool warned = false;
+        if (!warned.exchange(true))
+          WARN("Skipping dispatches whose compute pipeline failed to compile (see the error above)");
         return;
+      }
       auto &cmd = enc.encodeComputeCommand<wmtcmd_compute_setpso>();
       cmd.type = WMTComputeCommandSetPSO;
       cmd.pso = ComputePipeline.PipelineState;
diff --git a/src/d3d11/d3d11_pipeline.cpp b/src/d3d11/d3d11_pipeline.cpp
index 2f26b7d..b6ce79b 100644
--- a/src/d3d11/d3d11_pipeline.cpp
+++ b/src/d3d11/d3d11_pipeline.cpp
@@ -172,7 +172,8 @@ public:
     info.tgsize_is_multiple_of_sgwidth = tgsize_is_multiple_of_sgwidth;
     info.immutable_buffers = (1 << 29) | (1 << 30);
 
-    state_ = device_->GetMTLDevice().newComputePipelineState(info, err);
+    auto device = device_->GetMTLDevice();
+    state_ = CreatePipelineRetryingInterrupted([&] { return device.newComputePipelineState(info, err); }, err);
 
     if (!state_) {
       ERR("Failed to create compute PSO: ", err.description().getUTF8String());
diff --git a/src/d3d11/d3d11_pipeline.hpp b/src/d3d11/d3d11_pipeline.hpp
index dedd095..3415681 100644
--- a/src/d3d11/d3d11_pipeline.hpp
+++ b/src/d3d11/d3d11_pipeline.hpp
@@ -18,20 +18,26 @@ pixel shader reading a varying the geometry shader does not write; Crysis 3). Ev
 pipeline compiling at that moment then fails with XPC_ERROR_CONNECTION_INTERRUPTED,
 valid ones included; those compile once the service has restarted.
 */
-template <typename Info>
-WMT::Reference<WMT::RenderPipelineState>
-NewRenderPipelineStateRetryingInterrupted(WMT::Device device, const Info &info, WMT::Reference<WMT::Error> &err) {
+template <typename Create>
+auto
+CreatePipelineRetryingInterrupted(Create &&create, WMT::Reference<WMT::Error> &err) {
   constexpr unsigned kMaxRetries = 2;
-  auto pso = device.newRenderPipelineState(info, err);
+  auto pso = create();
   for (unsigned retry = 1; !pso && err && retry <= kMaxRetries; retry++) {
     if (err.description().getUTF8String().find("XPC_ERROR_CONNECTION_INTERRUPTED") == std::string::npos)
       break;
     WARN("Metal compiler service connection interrupted, retrying pipeline creation (", retry, "/", kMaxRetries, ")");
-    pso = device.newRenderPipelineState(info, err);
+    pso = create();
   }
   return pso;
 }
 
+template <typename Info>
+WMT::Reference<WMT::RenderPipelineState>
+NewRenderPipelineStateRetryingInterrupted(WMT::Device device, const Info &info, WMT::Reference<WMT::Error> &err) {
+  return CreatePipelineRetryingInterrupted([&] { return device.newRenderPipelineState(info, err); }, err);
+}
+
 } // namespace dxmt
 
 struct MTL_GRAPHICS_PIPELINE_DESC {
diff --git a/src/dxmt/dxmt_context.hpp b/src/dxmt/dxmt_context.hpp
index 0a2d631..2a54fac 100644
--- a/src/dxmt/dxmt_context.hpp
+++ b/src/dxmt/dxmt_context.hpp
@@ -197,6 +197,12 @@ struct ComputeEncoderData : EncoderData {
   WMT::Buffer allocated_argbuf;
   uint64_t allocated_argbuf_offset;
   void *allocated_argbuf_mapping;
+  /**
+  The compute pipeline of the last set-pipeline command of this encoder failed to
+  compile; dispatches are dropped until one is set successfully (see
+  RenderEncoderData::pipeline_failed).
+  */
+  bool pipeline_failed = 0;
 };
 
 struct BlitEncoderData : EncoderData {
@@ -655,6 +661,12 @@ public:
     return static_cast<RenderEncoderData *>(encoder_current);
   }
 
+  ComputeEncoderData *
+  currentComputeEncoder() {
+    assert(encoder_current && encoder_current->type == EncoderType::Compute);
+    return static_cast<ComputeEncoderData *>(encoder_current);
+  }
+
   void *
   allocate_cpu_heap(size_t size, size_t alignment) {
     assert(size < kEncodingContextCPUHeapSize);
