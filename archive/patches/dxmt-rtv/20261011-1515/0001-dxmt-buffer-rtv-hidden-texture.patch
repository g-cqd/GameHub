From 214562d726bf1708ae6add589ad85059eedbd6d3 Mon Sep 17 00:00:00 2001
From: Gigi <42325924+g-cqd@users.noreply.github.com>
Date: Sun, 11 Oct 2026 15:26:24 +0200
Subject: [PATCH] fix(d3d11): back buffer render target views with a hidden
 texture

Metal cannot render into a buffer, and D3D11Buffer never overrode
CreateRenderTargetView, so every D3D11_RTV_DIMENSION_BUFFER view fell through
to the TResourceBase default and returned E_INVALIDARG. Frostbite
(Battlefield 3 and 4) creates such views (R32G32B32A32_FLOAT, 8192 elements)
and treats the failure as fatal.

A valid buffer RTV request (BIND_RENDER_TARGET, a description with
ViewDimension BUFFER and a known format) now creates a NumElements x 1
texture of the view format and returns a TEXTURE2D view of it, with a
one-time warning. Rendering into the view succeeds but never reaches the
buffer, and the view does not see the buffer contents. The view keeps the
texture alive through its private reference.

tests/dx11/dx11_buffer_rtv covers the Frostbite call and the cases that must
stay E_INVALIDARG.
---
 src/d3d11/d3d11_buffer.cpp     |  55 +++++++++++++++++
 tests/dx11/dx11_buffer_rtv.cpp | 105 +++++++++++++++++++++++++++++++++
 tests/dx11/meson.build         |   6 +-
 3 files changed, 165 insertions(+), 1 deletion(-)
 create mode 100644 tests/dx11/dx11_buffer_rtv.cpp

diff --git a/src/d3d11/d3d11_buffer.cpp b/src/d3d11/d3d11_buffer.cpp
index 1269d63..629e8c2 100644
--- a/src/d3d11/d3d11_buffer.cpp
+++ b/src/d3d11/d3d11_buffer.cpp
@@ -4,6 +4,8 @@
 #include "dxmt_dynamic.hpp"
 #include "dxmt_format.hpp"
 #include "d3d11_resource.hpp"
+#include <algorithm>
+#include <atomic>
 
 namespace dxmt {
 
@@ -285,6 +287,59 @@ public:
     return S_OK;
   };
 
+  /**
+   * Metal cannot render into a buffer, so a buffer render-target view
+   * (D3D11_RTV_DIMENSION_BUFFER) is backed by a hidden NumElements x 1
+   * texture of the view format. Draws into the view succeed, but they never
+   * reach the buffer and the view does not see the buffer's contents.
+   * Frostbite (Battlefield 3 and 4) creates such views and treats a failure
+   * as fatal.
+   */
+  HRESULT
+  STDMETHODCALLTYPE
+  CreateRenderTargetView(const D3D11_RENDER_TARGET_VIEW_DESC1 *pDesc, ID3D11RenderTargetView1 **ppView) override {
+    if (!(desc.BindFlags & D3D11_BIND_RENDER_TARGET))
+      return E_INVALIDARG;
+    // A buffer has no format to default to, so a view on it needs a description.
+    if (!pDesc || pDesc->ViewDimension != D3D11_RTV_DIMENSION_BUFFER || pDesc->Format == DXGI_FORMAT_UNKNOWN)
+      return E_INVALIDARG;
+
+    D3D11_TEXTURE2D_DESC1 textureDesc = {};
+    textureDesc.Width = std::max(pDesc->Buffer.NumElements, 1u);
+    textureDesc.Height = 1;
+    textureDesc.MipLevels = 1;
+    textureDesc.ArraySize = 1;
+    textureDesc.Format = pDesc->Format;
+    textureDesc.SampleDesc = {1, 0};
+    textureDesc.Usage = D3D11_USAGE_DEFAULT;
+    textureDesc.BindFlags = D3D11_BIND_RENDER_TARGET;
+    textureDesc.TextureLayout = D3D11_TEXTURE_LAYOUT_UNDEFINED;
+
+    static std::atomic<bool> s_warned = false;
+    if (!s_warned.exchange(true)) {
+      WARN(
+          "D3D11Buffer: render target view on a buffer (format ", pDesc->Format, ", ", textureDesc.Width,
+          " elements) is backed by a hidden texture; the buffer contents are not preserved"
+      );
+    }
+
+    Com<ID3D11Texture2D1> texture;
+    HRESULT hr = m_parent->CreateTexture2D1(&textureDesc, nullptr, &texture);
+    if (FAILED(hr)) {
+      ERR("D3D11Buffer: failed to create the texture behind a buffer render target view: ", textureDesc.Width,
+          "x1 format ", textureDesc.Format, " hr=", hr);
+      return E_INVALIDARG;
+    }
+
+    D3D11_RENDER_TARGET_VIEW_DESC1 viewDesc = {};
+    viewDesc.Format = pDesc->Format;
+    viewDesc.ViewDimension = D3D11_RTV_DIMENSION_TEXTURE2D;
+    viewDesc.Texture2D.MipSlice = 0;
+    viewDesc.Texture2D.PlaneSlice = 0;
+    // The view keeps a private reference on the texture, so it lives as long as the view.
+    return GetResourceCommon(texture.ptr())->CreateRenderTargetView(&viewDesc, ppView);
+  };
+
   void
   OnSetDebugObjectName(LPCSTR Name) override {
     if (!Name) {
diff --git a/tests/dx11/dx11_buffer_rtv.cpp b/tests/dx11/dx11_buffer_rtv.cpp
new file mode 100644
index 0000000..c6dc637
--- /dev/null
+++ b/tests/dx11/dx11_buffer_rtv.cpp
@@ -0,0 +1,105 @@
+// Regression test: CreateRenderTargetView on a buffer resource.
+//
+// Frostbite (Battlefield 3 / 4) creates a D3D11_RTV_DIMENSION_BUFFER view on a
+// buffer created with D3D11_BIND_RENDER_TARGET (R32G32B32A32_FLOAT, 8192
+// elements, as logged by the BF3 proxy) and shows a fatal "DirectX function ...
+// failed with E_INVALIDARG" dialog if it fails. Stock DXMT v0.80 returns
+// E_INVALIDARG for every buffer RTV. Exit code 0 means every check passed.
+#define COBJMACROS
+#include <d3d11.h>
+#include <cstdio>
+
+static int g_failures = 0;
+
+static void check(const char *what, HRESULT got, HRESULT want) {
+  bool ok = got == want;
+  if (!ok)
+    g_failures++;
+  std::printf("%s %-58s hr=0x%08lx (want 0x%08lx)\n", ok ? "PASS" : "FAIL", what, (unsigned long)got,
+              (unsigned long)want);
+}
+
+static ID3D11Buffer *make_buffer(ID3D11Device *device, UINT bind) {
+  D3D11_BUFFER_DESC bd = {};
+  bd.ByteWidth = 8192 * 16;
+  bd.Usage = D3D11_USAGE_DEFAULT;
+  bd.BindFlags = bind;
+  ID3D11Buffer *buffer = nullptr;
+  HRESULT hr = device->CreateBuffer(&bd, nullptr, &buffer);
+  if (FAILED(hr)) {
+    std::printf("FAIL CreateBuffer bind=0x%x hr=0x%08lx\n", bind, (unsigned long)hr);
+    g_failures++;
+  }
+  return buffer;
+}
+
+int main() {
+  ID3D11Device *device = nullptr;
+  ID3D11DeviceContext *context = nullptr;
+  D3D_FEATURE_LEVEL level = {};
+  HRESULT hr = D3D11CreateDevice(nullptr, D3D_DRIVER_TYPE_HARDWARE, nullptr, 0, nullptr, 0, D3D11_SDK_VERSION,
+                                 &device, &level, &context);
+  std::printf("D3D11CreateDevice hr=0x%08lx level=0x%x (%d-bit)\n", (unsigned long)hr, level,
+              (int)sizeof(void *) * 8);
+  if (FAILED(hr))
+    return 2;
+
+  D3D11_RENDER_TARGET_VIEW_DESC rd = {};
+  rd.Format = DXGI_FORMAT_R32G32B32A32_FLOAT;
+  rd.ViewDimension = D3D11_RTV_DIMENSION_BUFFER;
+  rd.Buffer.FirstElement = 0;
+  rd.Buffer.NumElements = 8192;
+
+  // 1. The Frostbite call: must succeed and return a usable view.
+  ID3D11Buffer *rtBuffer = make_buffer(device, D3D11_BIND_RENDER_TARGET | D3D11_BIND_SHADER_RESOURCE);
+  ID3D11RenderTargetView *view = nullptr;
+  if (rtBuffer) {
+    check("buffer RTV, R32G32B32A32_FLOAT x 8192 elements", device->CreateRenderTargetView(rtBuffer, &rd, &view),
+          S_OK);
+  }
+  if (view) {
+    D3D11_RENDER_TARGET_VIEW_DESC got = {};
+    view->GetDesc(&got);
+    std::printf("     view desc: format=%u dimension=%u\n", got.Format, got.ViewDimension);
+    // Exercise the view on the GPU: bind, clear, draw nothing, flush.
+    const float colour[4] = {0.25f, 0.5f, 0.75f, 1.0f};
+    D3D11_VIEWPORT vp = {0, 0, 8192, 1, 0, 1};
+    context->OMSetRenderTargets(1, &view, nullptr);
+    context->RSSetViewports(1, &vp);
+    context->ClearRenderTargetView(view, colour);
+    context->OMSetRenderTargets(0, nullptr, nullptr);
+    context->Flush();
+    std::printf("PASS bound, cleared and flushed the view\n");
+    // The second view on the same buffer must also work (the game creates several).
+    ID3D11RenderTargetView *second = nullptr;
+    check("second buffer RTV on the same buffer", device->CreateRenderTargetView(rtBuffer, &rd, &second), S_OK);
+    if (second)
+      second->Release();
+    view->Release();
+  }
+
+  // 2. Invalid calls stay invalid.
+  if (rtBuffer) {
+    check("buffer RTV with a NULL description", device->CreateRenderTargetView(rtBuffer, nullptr, &view), E_INVALIDARG);
+    D3D11_RENDER_TARGET_VIEW_DESC unknown = rd;
+    unknown.Format = DXGI_FORMAT_UNKNOWN;
+    check("buffer RTV with DXGI_FORMAT_UNKNOWN", device->CreateRenderTargetView(rtBuffer, &unknown, &view),
+          E_INVALIDARG);
+    D3D11_RENDER_TARGET_VIEW_DESC tex2d = rd;
+    tex2d.ViewDimension = D3D11_RTV_DIMENSION_TEXTURE2D;
+    check("TEXTURE2D view dimension on a buffer", device->CreateRenderTargetView(rtBuffer, &tex2d, &view),
+          E_INVALIDARG);
+    rtBuffer->Release();
+  }
+  ID3D11Buffer *srvOnly = make_buffer(device, D3D11_BIND_SHADER_RESOURCE);
+  if (srvOnly) {
+    check("buffer RTV without BIND_RENDER_TARGET", device->CreateRenderTargetView(srvOnly, &rd, &view), E_INVALIDARG);
+    srvOnly->Release();
+  }
+
+  context->Release();
+  ULONG left = device->Release();
+  std::printf("device released, refcount %lu\n", left);
+  std::printf("%s: %d failure(s)\n", g_failures ? "FAILED" : "OK", g_failures);
+  return g_failures ? 1 : 0;
+}
diff --git a/tests/dx11/meson.build b/tests/dx11/meson.build
index 8da860f..923a32a 100644
--- a/tests/dx11/meson.build
+++ b/tests/dx11/meson.build
@@ -28,4 +28,8 @@ executable('dx11_hdr_linear', ['dx11_hdr_linear.cpp'],
 
 executable('dx11_hdr_pq', ['dx11_hdr_pq.cpp'],
   dependencies: [ lib_d3d11, lib_dxgi, lib_d3dcompiler]
-)
\ No newline at end of file
+)
+
+executable('dx11_buffer_rtv', ['dx11_buffer_rtv.cpp'],
+  dependencies: [ lib_d3d11 ]
+)
