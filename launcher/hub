def epic_manifest_meta(path):
    """Return (build version, launch exe, launch command) from an Epic binary manifest, or None if it is not one.

    Reads only the header and the first 4 KB of the compressed body, where the meta section is."""
    with open(path, "rb") as f:
        head = f.read(41)
        if len(head) < 41 or struct.unpack_from("<I", head)[0] != 0x44BEC00C:
            return None
        hsize, _, csize = struct.unpack_from("<III", head, 4)
        f.seek(hsize)
        body = f.read(min(csize, 1 << 16))
    try:
        data = zlib.decompressobj().decompress(body, 4096) if head[36] & 1 else body[:4096]
        o = 14   # meta size u32, data version u8, feature level u32, is-file-data u8, app id u32
        out = []
        for _ in range(4):   # app name, build version, launch exe, launch command
            n = struct.unpack_from("<i", data, o)[0]
            o += 4
            size = -2 * n if n < 0 else n
            if size > len(data) - o:
                return None
            out.append(data[o:o + size].decode("utf-16-le" if n < 0 else "utf-8").rstrip("\0"))
            o += size
    except (zlib.error, struct.error, UnicodeDecodeError):
        return None
    return out[1], out[2], out[3]


def epic_app_name(game_dir):
    """Return the Epic app name that LauncherInstalled.dat lists for `game_dir`, or None when the game is not registered."""
    listing = PREFIX / "drive_c/ProgramData/Epic/UnrealEngineLauncher/LauncherInstalled.dat"
    try:
        entries = json.loads(listing.read_text()).get("InstallationList", [])
    except (OSError, ValueError) as e:
        print(f"hub: cannot read {listing}: {e}", file=sys.stderr)
        return None
    loc = unix_to_win(game_dir).lower()
    return next((e.get("AppName") for e in entries if e.get("InstallLocation", "").lower() == loc and e.get("AppName")), None)


def adopt_epic_installs():
    """Register in the Epic launcher each Library/Epic/<game> install that carries its .egstore and is not listed yet.

    Writes Data/Manifests/<guid>.item and the LauncherInstalled.dat entry, the two files the launcher reads at start.
    Call only while the launcher is stopped: it rewrites LauncherInstalled.dat when it exits."""
    lib = ROOT / "Library/Epic"
    data = PREFIX / "drive_c/ProgramData/Epic"
    listing = data / "UnrealEngineLauncher/LauncherInstalled.dat"
    try:
        installed = json.loads(listing.read_text()) if listing.exists() else {"InstallationList": []}
    except ValueError:
        print(f"hub: {listing} is not valid JSON; not adopting Epic installs", file=sys.stderr)
        return
    known = {e.get("InstallLocation", "").lower() for e in installed.get("InstallationList", [])}
    if known:   # a listing entry without its .item shows as broken: only complete pairs count as registered
        items = set()
        for f in (data / "EpicGamesLauncher/Data/Manifests").glob("*.item"):
            try:
                items.add(json.loads(f.read_text()).get("InstallLocation", "").lower())
            except (ValueError, OSError) as e:
                print(f"hub: unreadable Epic manifest {f}: {e}", file=sys.stderr)
        known &= items
    added = []
    for game in sorted(lib.iterdir()) if lib.is_dir() else []:
        loc = unix_to_win(game)
        if loc.lower() in known:
            continue
        # the launcher looks for <InstallationGuid>.manifest in .egstore: reuse the newest recorded guid
        for cpn in sorted((game / ".egstore").glob("*.mancpn"), key=lambda f: f.stat().st_mtime, reverse=True):
            try:
                ids = json.loads(cpn.read_text())
                ns, item, app = ids["CatalogNamespace"], ids["CatalogItemId"], ids["AppName"]
            except (ValueError, KeyError, OSError) as e:
                print(f"hub: skipping {cpn}: {e}", file=sys.stderr)
                continue
            meta = epic_manifest_meta(cpn.with_suffix(".manifest")) if cpn.with_suffix(".manifest").exists() else None
            if not meta:
                print(f"hub: skipping {game.name}: no readable manifest next to {cpn.name}", file=sys.stderr)
                continue
            version, exe, cmd = meta
            guid = cpn.stem.upper()
            record = {
                "FormatVersion": 0, "bIsIncompleteInstall": False, "LaunchCommand": cmd, "LaunchExecutable": exe,
                "ManifestLocation": loc + "/.egstore", "bIsApplication": True, "bIsExecutable": True, "bIsManaged": False,
                "bNeedsValidation": False, "bRequiresAuth": True, "bAllowMultipleInstances": False, "bCanRunOffline": False,
                "bAllowUriCmdArgs": False, "BaseURLs": [], "BuildLabel": "Live", "AppCategories": ["public", "games", "applications"],
                "ChunkDbs": [], "CompatibleApps": [], "DisplayName": game.name, "InstallationGuid": guid, "InstallLocation": loc,
                "InstallSessionId": "", "InstallTags": [], "InstallComponents": [], "HostInstallationGuid": "0" * 32,
                "PrereqIds": [], "StagingLocation": loc + "/.egstore/bps", "TechnicalType": "", "VaultThumbnailUrl": "",
                "VaultTitleText": "", "InstallSize": 0, "MainWindowProcessName": "", "ProcessNames": [],
                "BackgroundProcessNames": [], "MandatoryAppFolderName": game.name, "OwnershipToken": "false",
                "CatalogNamespace": ns, "CatalogItemId": item, "AppName": app, "AppVersionString": version,
                "MainGameCatalogNamespace": ns, "MainGameCatalogItemId": item, "MainGameAppName": app, "AllowedUriEnvVars": [],
            }
            manifests = data / "EpicGamesLauncher/Data/Manifests"
            manifests.mkdir(parents=True, exist_ok=True)
            tmp = manifests / f"{guid}.item.tmp"
            tmp.write_text(json.dumps(record, indent="\t"))
            os.replace(tmp, manifests / f"{guid}.item")
            installed["InstallationList"] = [e for e in installed.get("InstallationList", [])
                                              if e.get("InstallLocation", "").lower() != loc.lower()]
            installed["InstallationList"].append(
                {"InstallLocation": loc, "NamespaceId": ns, "ItemId": item, "ArtifactId": app, "AppVersion": version, "AppName": app})
            known.add(loc.lower())
            added.append(game.name)
            break
    if added:
        listing.parent.mkdir(parents=True, exist_ok=True)
        tmp = listing.with_suffix(".tmp")
        tmp.write_text(json.dumps(installed, indent="\t"))
        os.replace(tmp, listing)
        print(f"registered with the Epic launcher: {', '.join(added)}")


def prep_steam():
    od = STEAM / "_overlay-disabled"
    od.mkdir(exist_ok=True)
    for n in ("GameOverlayRenderer.dll", "GameOverlayRenderer64.dll", "gameoverlayui.exe", "gameoverlayui64.exe", "GameOverlayUI.exe"):
        if (STEAM / n).exists():   # the overlay crashes Act of Aggression right after its intro
            shutil.move(str(STEAM / n), str(od / n))
    (STEAM / "steam.cfg").write_bytes(b"BootStrapperInhibitAll=enable\r\nBootStrapperForceSelfUpdate=disable\r\n")


def start_provider(provider, rt, opts):
    env = session_env(rt, provider, opts)
    if provider == "steam":
        if not (STEAM / "steam.exe").exists():
            die(f"Steam not found at {STEAM}")
        prep_steam()
        conn = STEAM / "logs/connection_log.txt"
        off, log = size(conn), LOGS / f"steam-{stamp()}.log"
        spawn(rt, env, ["E:\\Library\\Steam\\steam.exe", "-noverifyfiles", "-nobootstrapupdate", "-skipinitialbootstrap",
                        "-inhibitbootstrap", "-no-cef-sandbox"], log)
        print(f"starting Steam on {rt} (log {log})")
        ok = wait_for(lambda: "Logged On" in log_tail_from(conn, off), 120, "Steam to log on")
        if not ok:
            die("Steam did not log on; see the log above")
    elif provider == "ea":
        exe = ea_client()
        if not exe:
            die("EA Desktop not found in the prefix")
        log = LOGS / f"ea-{stamp()}.log"
        ealog = PREFIX / "drive_c/ProgramData/EA Desktop/Logs/EADesktop.log"
        off = size(ealog)
        spawn(rt, env, [unix_to_win(exe), "--in-process-gpu"], log)
        print(f"starting EA Desktop on {rt} (log {log})")

        waiting = {}

        def booted():
            t = log_tail_from(log, 0) + log_tail_from(ealog, off)
            if "SPA load success" in t:
                return True
            states = re.findall(r"state changed: \w+ -> (\w+)", t)
            if states and states[-1] == "awaitingAuthentication":   # a normal passing state; only a lasting one means "sign in"
                waiting.setdefault("since", time.time())
                if time.time() - waiting["since"] > 25 and not waiting.get("told"):
                    waiting["told"] = True
                    print("hub: EA is waiting for you to sign in; do it in the EA window", file=sys.stderr)
            else:
                waiting.pop("since", None)
            return False
        if not wait_for(booted, 150, "EA Desktop to finish booting"):
            die("EA Desktop did not finish booting (not signed in?)")
        STATE.mkdir(parents=True, exist_ok=True)
        (STATE / "ea-log").write_text(str(log))
    elif provider == "ubisoft":
        exe = UBISOFT / "upc.exe"
        if not exe.exists():
            exe = UBISOFT / "UbisoftConnect.exe"
        if not exe.exists():
            die("Ubisoft Connect not found")
        spawn(rt, env, [unix_to_win(exe), "--in-process-gpu"], LOGS / f"ubisoft-{stamp()}.log")
        print(f"starting Ubisoft Connect on {rt}")
        time.sleep(15)
    elif provider == "epic":
        exe = epic_client()
        if not exe:
            die("Epic Games Launcher not found in the prefix")
        adopt_epic_installs()
        log = LOGS / f"epic-{stamp()}.log"
        spawn(rt, env, [unix_to_win(exe), "-SkipBuildPatchPrereq"], log)
        print(f"starting Epic Games Launcher on {rt} (log {log})")
        time.sleep(10)
    STATE.mkdir(parents=True, exist_ok=True)
    (STATE / "session.json").write_text(json.dumps(signature(rt, provider, opts)))
    return env


def ea_booted():
    t = log_tail_from(PREFIX / "drive_c/ProgramData/EA Desktop/Logs/EADesktop.log", 0)
    t = t[t.rfind("[STARTUP]"):]   # the log accumulates sessions: only the current one counts
    return "SPA load success" in t


def stop_all(rt=None):
    rt = rt or running_runtime()
    if not rt:
        print("nothing is running in the prefix")
        return
    env = {"PATH": "/usr/bin:/bin:/usr/sbin:/sbin", "WINEPREFIX": str(PREFIX), "WINEMSYNC": "1"}
    ws = str(RUNTIMES / rt / "bin/wineserver")
    subprocess.run([ws, "-k"], env=env, capture_output=True)
    subprocess.run([ws, "-w"], env=env, capture_output=True, timeout=90)
    time.sleep(1)
    left = [c for _, _, c in ps() if "/Runtimes/" in c and re.search(r"wineserver|x87sidecar", c) or "C:\\windows" in c]
    print("stopped everything in the prefix" if not left else f"{len(left)} process(es) still exiting")


# ---------------------------------------------------------------- play

def play(args):
    games = discover()
    g = find_game(games, args.game)
    if not g.installed:
        die(f"{g.name} is not usable: {g.note or 'not installed'}")
    if g.status == "blocked" and not args.force:
        die(f"{g.name} is known not to work: {g.note}. (--force to try anyway)")
    provider = g.provider
    rt = args.runtime or os.environ.get("HUB_RUNTIME") or PROVIDER_RUNTIME.get(provider if provider in PROVIDER_RUNTIME else "direct")
    if not (RUNTIMES / rt / "bin/wine").exists():
        die(f"runtime {rt} not found (ExT2 mounted?)")
    cur_rt, up = running_runtime(), provider_running()
    try:
        session = json.loads((STATE / "session.json").read_text())
    except (OSError, ValueError):
        session = {}
    # launcher environment (runtime, MetalFX, backend) is fixed when the launcher starts: an explicit different option needs a restart
    changed = provider in up and any(getattr(args, k) is not None and getattr(args, k) != session.get(k) for k in ("metalfx", "dxgi"))
    other_launchers = up - {provider}
    needs_restart = bool(cur_rt) and (cur_rt != rt or changed or bool(other_launchers))
    if needs_restart:
        busy = all_running_games(games)
        if busy and not args.restart:
            die("another game is running in the prefix: " + ", ".join(b.name for b in busy) + ". Close it, or use --restart")
        print(f"restarting the prefix session ({cur_rt} -> {rt}, {sorted(up) or 'no launcher'})")
        stop_all(cur_rt)
        up = set()
    elif args.restart:
        stop_all(cur_rt)
        up = set()
    env = session_env(rt, provider, args)
    need = provider if provider in ("steam", "ea", "epic") else ("ubisoft" if provider == "ubisoft" else None)
    if need and need not in provider_running():
        env = start_provider(need, rt, args)
    if provider == "ea" and not ea_booted():
        if not wait_for(ea_booted, 120, "EA Desktop to finish booting (sign in if it asks)"):
            die("EA Desktop is not ready")
    if g.status != "verified":
        print(f"note: {g.name} has not been confirmed working here ({g.note or 'unverified'})")
    # per-game settings
    if g.id in SETTINGS:
        rel, golden = SETTINGS[g.id]
        live, keep = PREFIX / rel, STATE / g.name.replace(" ", "") / Path(rel).name
        live.parent.mkdir(parents=True, exist_ok=True)
        keep.parent.mkdir(parents=True, exist_ok=True)
        if not live.exists():
            shutil.copy2(keep if keep.exists() else HERE / golden, live)
    offsets = {"console": size(STEAM / "logs/console_log.txt")}
    plog = LOGS / f"play-{norm(g.name)}-{stamp()}.log"
    if provider == "steam":
        spawn(rt, env, ["E:\\Library\\Steam\\steam.exe", f"steam://rungameid/{g.id}"], plog)
    elif provider == "ea":
        launcher = unix_to_win(ea_client().parent / "EALauncher.exe")
        def fire(offer):
            subprocess.run([str(RUNTIMES / rt / "bin/wine"), launcher, f"origin2://game/launch/?offerIds={offer}"], env=env,
                           cwd=str(TEMP), stdin=subprocess.DEVNULL, stdout=open(plog, "ab"), stderr=subprocess.STDOUT, timeout=120)
        if g.extra.get("prime"):   # NFS 2015: prime EA's catalog cache with the public offer id first, or the launch is dropped
            fire(g.extra["prime"])
            time.sleep(15)
        fire(g.extra["offer"])
    elif provider == "epic":   # Epic games need the launcher's auth arguments: ask the launcher to start the game
        app = epic_app_name(g.path)
        if not app:
            die(f"{g.name} is not registered in the Epic launcher; run `hub start epic` once so it adopts {g.path}")
        spawn(rt, env, ["start", f"com.epicgames.launcher://apps/{app}?action=launch&silent=true"], plog)
    else:
        exe = g.extra.get("exe")
        spawn(rt, env, [unix_to_win(exe)], plog, cwd=exe.parent)
    print(f"launching {g.name} via {provider} (log {plog})")
    if args.no_wait:
        return

    repaired_dlf = False

    def started():
        nonlocal repaired_dlf
        if provider == "steam":
            t = log_tail_from(STEAM / "logs/console_log.txt", offsets["console"])
            m = re.search(r"LaunchApp failed with (\w+)", t)
            if m:
                die(f"Steam could not launch {g.name} ({m.group(1)}). If it was updating (check Library/Steam/logs/content_log.txt, "
                    "for example 'Steamworks Shared' after folder changes) wait for the update and run the command again")
        elif provider == "ea" and not repaired_dlf:
            act = [pid for pid, _, cmd in ps() if "activationui.exe" in cmd.lower() and "x87sidecar" not in cmd]
            if act:
                repaired_dlf = True
                lic_dir = PREFIX / "drive_c/ProgramData/Electronic Arts/EA Services/License"
                moved = []
                for cid in str(g.extra.get("offer", "")).split(","):
                    dlf = lic_dir / f"{cid.strip()}.dlf"
                    if dlf.is_file():
                        bak = lic_dir / f"{dlf.name}.stale-machine-hash-{stamp()}"
                        dlf.rename(bak)
                        moved.append(dlf.name)
                if moved:
                    print(f"hub: stale EA licence ({', '.join(moved)}) triggered ActivationUI; moving aside and relaunching {g.name}")
                    for pid in act + [p for p, _, _ in game_procs(g)]:
                        try:
                            os.kill(pid, 15)
                        except OSError:
                            pass
                    time.sleep(3)
                    fire(g.extra["offer"])
                    return []
        return game_procs(g)
    procs = wait_for(started, 300 if provider == "steam" else 180, f"{g.name} to start", every=3)
    if procs:
        print(f"{g.name} is running (pid {procs[0][0]})")
        if provider in TRIM_PATTERNS and not args.keep_launcher:   # free the launcher's memory once the game has had time to start up
            subprocess.Popen([sys.executable, str(Path(__file__).resolve()), "_trim_later", provider, str(TRIM_DELAY)], start_new_session=True,
                             stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            print(f"the {provider} launcher will be stopped in {TRIM_DELAY} s to free memory (--keep-launcher to prevent)")
        if g.id in SETTINGS:   # copy the settings the game saved once it exits
            subprocess.Popen([sys.executable, str(Path(__file__).resolve()), "_keep", g.id], start_new_session=True,
                             stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    else:
        sys.exit(1)


def keep_settings(gid):
    games = [g for g in discover() if g.id == gid]
    if not games:
        return
    g = games[0]
    rel, _ = SETTINGS[gid]
    live, keep = PREFIX / rel, STATE / g.name.replace(" ", "") / Path(rel).name
    while game_procs(g):
        time.sleep(5)
    if live.exists():
        keep.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(live, keep)


# ---------------------------------------------------------------- commands

def cmd_list(args):
    games = discover()
    rows = [("GAME", "LAUNCHER", "ID", "STATE", "NOTES")]
    for g in games:
        if not g.installed and not args.all and g.id != "-":
            continue
        state = "blocked" if g.status == "blocked" else ("running" if g.installed and game_procs(g) else ("ready" if g.installed else "-"))
        notes = {"verified": "works", "unverified": "unverified"}.get(g.status, "") if g.installed else ""
        rows.append((g.name, g.provider, g.id, state, "; ".join(x for x in (notes, g.note) if x)))
    w = [max(len(r[i]) for r in rows) for i in range(4)]
    for r in rows:
        print("  ".join(r[i].ljust(w[i]) for i in range(4)) + "  " + r[4])


def cmd_status(args):
    rt, up = running_runtime(), provider_running()
    print(f"runtime: {rt or 'none running'}   launchers: {', '.join(sorted(up)) or 'none'}")
    for g in discover():
        if g.installed:
            for pid, et, cmd in game_procs(g)[:1]:
                print(f"running: {g.name} (pid {pid}, {et})")


def cmd_start(args):
    prov = args.provider
    rt = args.runtime or PROVIDER_RUNTIME[prov]
    cur = running_runtime()
    if cur and cur != rt:
        die(f"{cur} is serving the prefix; run 'hub stop' first (a prefix can use one runtime at a time)")
    up = provider_running()
    if prov in up:
        print(f"{prov} is already running")
        return
    start_provider(prov, rt, args)


def cmd_stop(args):
    if args.game:
        g = find_game(discover(), args.game)
        procs = game_procs(g)
        if not procs:
            print(f"{g.name} is not running")
        for pid, _, _ in procs:
            os.kill(pid, 15)
        return
    stop_all()


# Processes of a store launcher that a running game does not need: closing them returns their memory (the Epic stack held
# about 5 GB, mostly compressed, while GTA V ran, and the Mac swapped 50-400 MB/s)
TRIM_PATTERNS = {"epic": r"EpicGamesLauncher\.exe|EpicWebHelper\.exe|EpicOnlineServices|EOSOverlayRenderer|EpicGamesUpdater\.exe"}


def cmd_trim(args):
    """Stop the launcher processes of `args.provider` and leave the game, the other launchers and the wineserver running."""
    pat = re.compile(TRIM_PATTERNS[args.provider])
    victims = [(pid, cmd) for pid, _, cmd in ps() if pat.search(cmd) and "x87sidecar" not in cmd and "launcher/hub" not in cmd]
    for pid, cmd in victims:
        try:
            os.kill(pid, 15)
        except OSError as e:
            print(f"hub: cannot stop {pid}: {e}", file=sys.stderr)
    print(f"stopped {len(victims)} {args.provider} launcher process(es); the game and the Wine server keep running")


TRIM_DELAY = 90   # seconds after the game's process appeared


def trim_later(provider, delay):
    """Stop the launcher processes after `delay` seconds, unless the game is already gone."""
    time.sleep(float(delay))
    if running_runtime():
        cmd_trim(argparse.Namespace(provider=provider))


def cmd_doctor(args):
    ok = True

    def chk(label, cond, hint=""):
        nonlocal ok
        ok &= bool(cond)
        print(f"[{'ok' if cond else 'FAIL'}] {label}" + (f"  -> {hint}" if not cond and hint else ""))
    chk(f"volume {ROOT}", ROOT.is_dir(), "plug in and mount ExT2")
    chk(f"prefix {PREFIX}", (PREFIX / "system.reg").exists())
    for rt in sorted(set(PROVIDER_RUNTIME.values())):
        chk(f"runtime {rt}", (RUNTIMES / rt / "bin/wine").exists())
    chk("Steam client", (STEAM / "steam.exe").exists())
    reg = (PREFIX / "user.reg").read_text(errors="replace") if (PREFIX / "user.reg").exists() else ""
    chk("registry SteamPath -> Library/Steam", 'SteamPath"="e:/library/steam"' in reg, "run hub start steam once; Steam rewrites it")
    chk("no stale SteamOld references", "steamold" not in reg.lower())
    chk("EA Desktop client", ea_client() is not None)
    chk("Epic Games Launcher client", epic_client() is not None)
    chk("Steam overlay disabled", not (STEAM / "GameOverlayRenderer.dll").exists())
    for rt in sorted(set(PROVIDER_RUNTIME.values())):
        for api, b in (("dxgi", "dxmt"), ("dxgi", "wined3d"), ("d3d9", "mtld3d")):
            chk(f"{rt}: {api}/{b} backend", backend_ok(rt, api, b))
    rt = running_runtime()
    print(f"running runtime: {rt or 'none'}; launchers: {sorted(provider_running()) or 'none'}")
    sys.exit(0 if ok else 1)


def main():
    ap = argparse.ArgumentParser(prog="hub", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)

    def common(p):
        p.add_argument("--runtime"), p.add_argument("--debug"), p.add_argument("--dxgi", choices=["dxmt", "wined3d"])
        p.add_argument("--metalfx", nargs="?", const="1.40625", metavar="FACTOR")
    p = sub.add_parser("list"); p.add_argument("--all", action="store_true"); p.set_defaults(f=cmd_list)
    p = sub.add_parser("play"); p.add_argument("game"); common(p)
    p.add_argument("--restart", action="store_true"); p.add_argument("--no-wait", action="store_true"); p.add_argument("--force", action="store_true"); p.add_argument("--keep-launcher", action="store_true")
    p.set_defaults(f=play)
    p = sub.add_parser("start"); p.add_argument("provider", choices=["steam", "ea", "ubisoft", "epic"]); common(p); p.set_defaults(f=cmd_start)
    sub.add_parser("status").set_defaults(f=cmd_status)
    p = sub.add_parser("trim", help="stop a store launcher while its game runs, to free memory"); p.add_argument("provider", choices=sorted(TRIM_PATTERNS)); p.set_defaults(f=cmd_trim)
    p = sub.add_parser("stop"); p.add_argument("game", nargs="?"); p.set_defaults(f=cmd_stop)
    sub.add_parser("doctor").set_defaults(f=cmd_doctor)
    p = sub.add_parser("_keep"); p.add_argument("gid"); p.set_defaults(f=lambda a: keep_settings(a.gid))
    p = sub.add_parser("_trim_later"); p.add_argument("provider"); p.add_argument("delay"); p.set_defaults(f=lambda a: trim_later(a.provider, a.delay))
    args = ap.parse_args()
    if args.cmd not in ("_keep", "_trim_later") and not ROOT.is_dir():
        die(f"{ROOT} is not mounted (plug in ExT2)")
    for d in (LOGS, STATE, TEMP, HOME):
        d.mkdir(parents=True, exist_ok=True)
    args.f(args)


if __name__ == "__main__":
    main()
