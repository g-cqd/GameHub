class Game:
    def __init__(self, name, provider, gid, path, installed=True, status="unverified", note="", **extra):
        self.name, self.provider, self.id, self.path = name, provider, str(gid), Path(path) if path else None
        self.installed, self.status, self.note, self.extra = installed, status, note, extra


def norm(s):
    return re.sub(r"[^a-z0-9]", "", s.lower())


def win_to_unix(p):
    p = p.strip().replace("\\\\", "\\")
    m = re.match(r"^([A-Za-z]):[\\/]*(.*)$", p)
    if not m:
        return Path(p)
    d, rest = m.group(1).upper(), m.group(2).replace("\\", "/")
    base = {"E": ROOT, "C": PREFIX / "drive_c", "Z": Path("/")}.get(d, ROOT)
    return base / rest


def unix_to_win(p):
    p = Path(p)
    for pre, d in ((PREFIX / "drive_c", "C"), (ROOT, "E")):
        try:
            return d + ":\\" + str(p.relative_to(pre)).replace("/", "\\")
        except ValueError:
            pass
    return "Z:" + str(p).replace("/", "\\")


# ---------------------------------------------------------------- discovery

def parse_acf(path):
    t = path.read_text(errors="replace")
    return {k: v for k, v in re.findall(r'"(\w+)"\s+"([^"]*)"', t)}


def steam_libraries():
    libs = [STEAM / "steamapps"]
    vdf = STEAM / "steamapps/libraryfolders.vdf"
    if vdf.exists():
        for p in re.findall(r'"path"\s+"([^"]+)"', vdf.read_text(errors="replace")):
            q = win_to_unix(p) / "steamapps"
            if q not in libs:
                libs.append(q)
    return libs


def discover_steam():
    games, known_dirs = [], set()
    for lib in steam_libraries():
        for acf in sorted(lib.glob("appmanifest_*.acf")):
            m = parse_acf(acf)
            appid = m.get("appid", acf.stem.split("_")[1])
            if appid in STEAM_SKIP:
                continue
            d = lib / "common" / m.get("installdir", "")
            known_dirs.add(d)
            ok = bool(int(m.get("StateFlags", "0")) & 4) and d.is_dir()
            games.append(Game(re.sub(r"[™®]", "", m.get("name", appid)), "steam", appid, d, ok, "verified" if appid in ("318020",) else "unverified",
                              "" if ok else "not fully installed", installdir=m.get("installdir", "")))
        common = lib / "common"
        if common.is_dir():
            for d in sorted(common.iterdir()):
                if d.is_dir() and d not in known_dirs and d.name not in ("Steamworks Shared", "Steam Controller Configs"):
                    games.append(Game(d.name, "steam", "-", d, False, "unverified",
                                      "files present, unknown to Steam: install it from Steam into this library to adopt them"))
    return games


def reg_sections(path):
    """Yield (section name, {key: value}) from a Wine .reg text file."""
    sec, vals = None, {}
    with open(path, errors="replace") as f:
        for line in f:
            if line.startswith("["):
                if sec is not None:
                    yield sec, vals
                sec, vals = line[1:line.rindex("]")].replace("\\\\", "\\"), {}
            elif sec is not None and line.startswith('"'):
                m = re.match(r'"((?:[^"\\]|\\.)*)"="(.*)"\s*$', line)
                if m:
                    vals[m.group(1)] = re.sub(r"\\x([0-9a-fA-F]{4})", lambda x: chr(int(x.group(1), 16)), m.group(2)).replace("\\\\", "\\")
        if sec is not None:
            yield sec, vals


def discover_ea():
    games = []
    for sec, v in reg_sections(PREFIX / "system.reg"):
        m = re.match(r"Software\\Wow6432Node\\(EA Games|Crytek)\\([^\\]+)$", sec)
        if not m or "Install Dir" not in v:
            continue
        title = m.group(2)
        d = win_to_unix(v["Install Dir"])
        k = EA_KNOWN.get(title, {})
        name = k.get("name") or re.sub(r"[™®]", "", v.get("DisplayName", title)).strip()
        offer = k.get("offer")
        if not offer:
            f = d / "__Installer/installerdata.xml"
            if f.exists():
                ids = re.findall(r"<contentID>\s*([^<\s]+)", f.read_text(errors="replace"))
                offer = ids[0] if ids else None
        games.append(Game(name, "ea", offer or "-", d, d.is_dir(), k.get("status", "unverified"),
                          k.get("note", "" if offer else "no content id found"), offer=offer, prime=k.get("prime")))
    seen = {g.path for g in games}
    for d in sorted(EA_GAMES.iterdir()) if EA_GAMES.is_dir() else []:   # installed in EA's library but not registered in the prefix
        f = d / "__Installer/installerdata.xml"
        if d.is_dir() and d not in seen and f.exists():
            ids = re.findall(r"<contentID>\s*([^<\s]+)", f.read_text(errors="replace"))
            k = EA_KNOWN.get(d.name, {})
            games.append(Game(k.get("name", d.name), "ea", ids[0] if ids else "-", d, True, k.get("status", "unverified"),
                              k.get("note", "not registered in the prefix"), offer=ids[0] if ids else None, prime=k.get("prime")))
    return games


def discover_other():
    games = []
    for base, prov in ((UBISOFT / "games", "ubisoft"), (ROOT / "Library/Epic", "epic")):
        if base.is_dir():
            for d in sorted(base.iterdir()):
                if d.is_dir():
                    k = OTHER_KNOWN.get(d.name, {})
                    exe = d / k["exe"] if "exe" in k else None
                    games.append(Game(d.name, prov, "-", d, bool(exe and exe.exists()), k.get("status", "unverified"),
                                      k.get("note", "" if exe else "main exe unknown"), exe=exe))
    return games


def discover():
    return discover_steam() + discover_ea() + discover_other()


def find_game(games, query):
    q = ALIASES.get(norm(query), query)
    inst = [g for g in games if g.installed]
    for pool in (inst, games):
        hit = [g for g in pool if g.id == q or g.name == q or norm(g.name) == norm(q)]
        if not hit:
            hit = [g for g in pool if norm(q) and norm(q) in norm(g.name)]
        if len(hit) == 1:
            return hit[0]
        if len(hit) > 1:
            names = ", ".join(f"{g.name} [{g.provider}]" for g in hit)
            die(f"'{query}' is ambiguous: {names}")
    die(f"no game matches '{query}' (try: hub list)")


# ---------------------------------------------------------------- processes

def die(msg, code=1):
    print(f"hub: {msg}", file=sys.stderr)
    sys.exit(code)


def ps():
    out = subprocess.run(["ps", "-axo", "pid=,etime=,command="], capture_output=True, text=True).stdout
    rows = []
    for line in out.splitlines():
        p = line.split(None, 2)
        if len(p) == 3 and p[0].isdigit():
            rows.append((int(p[0]), p[1], p[2]))
    return rows


def running_runtime():
    for _, _, cmd in ps():
        m = re.search(r"/Runtimes/([^/]+)/.*bin/wineserver", cmd)
        if m:
            return m.group(1)
    return None


def provider_running():
    pats = {"steam": r"Library\\Steam\\steam\.exe", "ea": r"EADesktop\.exe", "ubisoft": r"UbisoftConnect\.exe|upc\.exe", "epic": r"EpicGamesLauncher\.exe"}
    found = set()
    for _, _, cmd in ps():
        if "x87sidecar" in cmd:
            continue
        for k, p in pats.items():
            if re.search(p, cmd):
                found.add(k)
    return found


def game_procs(g):
    if not g.path:
        return []
    key = ("\\" + g.path.name + "\\").lower()   # \Zero Hour\ must not match "...Generals - Zero Hour\"
    return [(pid, et, cmd) for pid, et, cmd in ps() if key in cmd.lower() and ".exe" in cmd.lower() and "x87sidecar" not in cmd]


def all_running_games(games):
    return [g for g in games if g.installed and game_procs(g)]


# ---------------------------------------------------------------- environment

def backend_ok(rt, api, backend):
    return (RUNTIMES / rt / "lib/wine" / api / backend).is_dir()


def metalfx_factor(value):
    """Return `value` as a DXMT spatial upscale factor string; exit when it is not a number in (1.0, 2.0]."""
    try:
        f = float(value)
    except ValueError:
        f = 0.0
    if not 1.0 < f <= 2.0:
        die(f"--metalfx factor must be a number above 1.0 and at most 2.0, got {value!r}")
    return repr(f)


def game_env(provider, fx):
    """Return {exe: ["NAME=value", ...]} for the game processes of `provider` (see GAME_PROCS).

    Each process gets DXMT's info log in Hub/Logs/dxmt-<game>/, its settings file when launcher/settings/<game>/dxmt.conf
    exists, and the MetalFX swapchain when `fx` (a factor from metalfx_factor) is set."""
    out = {}
    for exe, folder in GAME_PROCS.get(provider, {}).items():
        logs = LOGS / f"dxmt-{folder.lower()}"
        logs.mkdir(parents=True, exist_ok=True)
        env = ["DXMT_LOG_LEVEL=info", f"DXMT_LOG_PATH={logs}"]
        if os.environ.get("HUB_DXMT_DUMP"):   # debug: write every shader's DXBC to Hub/Logs/dxmt-<game>/shaders/ (needs the gtav-precise-divide DXMT build)
            (logs / "shaders").mkdir(exist_ok=True)
            env.append(f"DXMT_DUMP_SHADERS={logs / 'shaders'}")
        conf = HERE / "settings" / folder / "dxmt.conf"
        if conf.is_file():
            env.append(f"DXMT_CONFIG_FILE={conf}")   # a unix path: DXMT cannot open the same file given as Z:\\...
        if fx:
            env += ["DXMT_METALFX_SPATIAL_SWAPCHAIN=1", f"DXMT_CONFIG=d3d11.metalSpatialUpscaleFactor={fx}"]
        out[exe] = env
    return out


def compat_db(rt, gd="dxmt", exe_env=None):
    rules = [("steam-webhelper", "steamwebhelper.exe", "dxgi", "dxmt"),
             ("ea-cef", "EACefSubProcess.exe", "dxgi", "wined3d"),
             ("ea-gep", "EAGEP.exe", "dxgi", "wined3d"),
             ("epic-cef", "EpicWebHelper.exe", "dxgi", "wined3d"),
             ("aoa", "ActOfAggressionRE.exe", "dxgi", gd), ("aoa2", "ActOfAggression.exe", "dxgi", gd)]
    lines = ["v=3"] + [f"name={n};exe={e};{a}={b}" for n, e, a, b in rules if backend_ok(rt, a, b)]
    if backend_ok(rt, "dxgi", "dxmt"):   # env= fields reach only the named process, not the launcher or Wine services
        lines += [f"name=game-{i};exe={e};dxgi=dxmt;" + ";".join(f"env={v}" for v in env) for i, (e, env) in enumerate((exe_env or {}).items())]
    lines.append("name=default;exe=*;d3d9=mtld3d;dxgi=dxmt")   # total default, always last
    return "\n".join(lines)


def session_env(rt, provider, opts):
    rtp = RUNTIMES / rt
    fx = metalfx_factor(opts.metalfx) if opts.metalfx else None
    scoped = provider in GAME_PROCS
    ext = rtp / "lib/external"
    env = {"PATH": "/usr/bin:/bin:/usr/sbin:/sbin", "LANG": "en_US.UTF-8", "USER": "Player", "HOME": str(HOME), "TMPDIR": str(TEMP),
           "WINEPREFIX": str(PREFIX), "WINEMSYNC": "1", "WINEDEBUG": opts.debug or ("err+all" if provider == "steam" else "-all"),
           "WINEDLLOVERRIDES": "mscoree,mshtml=d;winemenubuilder.exe=d", "WINE_COMPATDB": compat_db(rt, opts.dxgi or "dxmt", game_env(provider, fx))}
    if ext.is_dir():
        env["DYLD_FALLBACK_LIBRARY_PATH"] = f"{ext}:{ext}/media:{ext}/vulkan"
        env["VK_ICD_FILENAMES"] = f"{ext}/vulkan/MoltenVK_icd.json"
        env["GST_PLUGIN_SYSTEM_PATH_1_0"] = env["GST_PLUGIN_PATH_1_0"] = f"{ext}/media/plugins"
        env["GST_REGISTRY_1_0"], env["GST_REGISTRY_FORK"], env["GST_DEBUG"] = str(TEMP / "gst-registry.bin"), "no", "0"
    if provider == "epic":   # the Epic Online Services MSI runs .NET custom actions; without mscoree it rolls back (EOS-ERR-1603)
        env["WINEDLLOVERRIDES"] = "mshtml=d;winemenubuilder.exe=d"
    if provider == "ea":
        env.update(MTL_HUD_ENABLED="0", WINE_TF_EMULATION="1", WINE_TF_MAX_STEPS="0", WINE_TF_MAX_NS="0",
                   WINEDLLOVERRIDES="IGOProxy32.exe=d;winemenubuilder.exe=d")
    if fx and not scoped:
        env["DXMT_METALFX_SPATIAL_SWAPCHAIN"] = "1"
        env["DXMT_CONFIG"] = f"d3d11.metalSpatialUpscaleFactor={fx}"
    return env


def signature(rt, provider, opts):
    return {"runtime": rt, "provider": provider, "metalfx": opts.metalfx, "dxgi": opts.dxgi or "dxmt", "debug": opts.debug}


def spawn(rt, env, args, log, cwd=None):
    LOGS.mkdir(parents=True, exist_ok=True)
    f = open(log, "ab")
    return subprocess.Popen([str(RUNTIMES / rt / "bin/wine")] + args, env=env, cwd=str(cwd or TEMP), stdin=subprocess.DEVNULL,
                            stdout=f, stderr=subprocess.STDOUT, start_new_session=True)


def stamp():
    return time.strftime("%Y%m%d-%H%M%S")


def wait_for(fn, timeout, what, every=2):
    t0 = time.time()
    while time.time() - t0 < timeout:
        r = fn()
        if r:
            return r
        time.sleep(every)
    print(f"hub: timed out after {timeout}s waiting for {what}", file=sys.stderr)
    return None


def log_tail_from(path, offset):
    try:
        with open(path, errors="replace") as f:
            f.seek(offset)
            return f.read()
    except OSError:
        return ""


def size(path):
    try:
        return Path(path).stat().st_size
    except OSError:
        return 0


