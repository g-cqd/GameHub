#!/bin/bash
RT="${HUB_RUNTIME:-/Volumes/ExT2/GameHub/Runtimes/hub-0-winemacfs-dxmtrtv}"
R="/Users/gc/Library/Application Support/BF3Mac"
ts=$(date +%Y%m%d-%H%M%S); log="/Volumes/ExT2/GameHub/Hub/Logs/ea-$ts.log"
COMPAT='v=3
name=ea-cef;exe=EACefSubProcess.exe;dxgi=wined3d
name=ea-gep;exe=EAGEP.exe;dxgi=wined3d
name=default;exe=*;d3d9=mtld3d;dxgi=dxmt'
cd "$R" && nohup env -i PATH=/usr/bin:/bin:/usr/sbin:/sbin LANG=en_US.UTF-8 USER=Player HOME="$R/RuntimeHome/Player" TMPDIR="$R/Temporary" WINEPREFIX="/Volumes/ExT2/GameHub/Prefix" WINEDEBUG="${HUB_WINEDEBUG:--all}" WINEMSYNC=1 MTL_HUD_ENABLED=0 WINE_TF_EMULATION=1 WINE_TF_MAX_STEPS=0 WINE_TF_MAX_NS=0 WINEDLLOVERRIDES="IGOProxy32.exe=d;winemenubuilder.exe=d" ROSETTA_X87_PATH="/Volumes/ExT2/GameHub/Runtimes/hub-0-helpers-fpr/x87sidecar" WINE_COMPATDB="$COMPAT" "$RT/bin/wine" 'C:\Program Files\Electronic Arts\EA Desktop\13.805.99.0\EA Desktop\EADesktop.exe' --in-process-gpu >"$log" 2>&1 &
echo "started pid $! log $log"
